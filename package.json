{
  "name": "vue-lynx-starter",
  "description": "Starter template for scaffolding a Lynx App using VueJS",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "rspeedy build",
    "dev": "rspeedy dev",
    "preview": "rspeedy preview",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check": "bun run fmt:check && bun run lint",
    "check:fix": "bun run fmt && bun run lint:fix",
    "release": "node --experimental-strip-types scripts/release.ts"
  },
  "dependencies": {
    "valibot": "^1.5.0",
    "vue": "^3.5.43",
    "vue-lynx": "^0.5.1"
  },
  "devDependencies": {
    "@lynx-js/qrcode-rsbuild-plugin": "^0.7.3",
    "@lynx-js/rspeedy": "^0.18.0",
    "@rsbuild/plugin-vue": "^2.0.1",
    "@types/node": "^26.6.4",
    "changelogen": "^0.6.2",
    "consola": "^3.4.2",
    "lefthook": "^2.1.16",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
